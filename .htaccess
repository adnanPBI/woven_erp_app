# Configure Passenger paths/runtime/environment through cPanel.
# Never commit hosting-generated credentials or account-specific paths.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:sync|deploy|tests|lib|docs|node_modules|\.git)(?:/|$) - [F,L,NC]
</IfModule>
<FilesMatch "^(?:\.env.*|\.git.*|package(?:-lock)?\.json|app\.js|server\.js|.*\.(?:log|sql|gz|zip))$">
    Require all denied
</FilesMatch>
