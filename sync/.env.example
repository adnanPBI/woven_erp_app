# Weaving ERP Import Mapper v3.2.3 hybrid — certified-source + provenance terminal-only production migration template
# Use the cPanel Node.js environment-variable screen or copy to .env only for CLI use.
# Never expose this file through public_html and never share real credentials.

CSV_DIR=./csv_files
SOURCE_MANIFEST_FILE=./source-manifest.json
# Set by scripts/v3/activate_certified_sources_v323.js after normalization.
NORMALIZATION_ATTESTATION_FILE=
MAPPING_CONTRACT_FILE=./mappings/mapping-contract-v2.json
LOG_DIR=./output

DB_HOST=localhost
DB_PORT=3306
DB_NAME=weavonpq_weaving
DB_USER=YOUR_PRODUCTION_DB_USER
DB_PASSWORD='YOUR_PRODUCTION_DB_PASSWORD'

# Hard database-name guard.
REQUIRE_DB_GUARD=true
IMPORT_EXPECTED_DB=weavonpq_weaving
PRODUCTION_DB_NAME=weavonpq_weaving

# Safe .env defaults remain disabled during setup and dry run. Explicit shell/cPanel values take precedence because dotenv override is disabled.
# A live command is permitted only when all three controls are present:
# 1) ALLOW_PRODUCTION_DB=true in the protected shell/environment
# 2) BACKUP_CONFIRMED=true after a fresh backup
# 3) --production-approval token matching this value
ALLOW_PRODUCTION_DB=false
PRODUCTION_APPROVAL_TOKEN=
BACKUP_CONFIRMED=false

# Every live run requires a generated and approved source manifest.
REQUIRE_SOURCE_MANIFEST=true
SKIP_SOURCE_MANIFEST_CHECK=false

# Mandatory business-owner decision. Supported meter aliases: meter, meters, metre, metres, mtr. Supported yard aliases: yard, yards, yds.
# The importer blocks folding/delivery while either value is unresolved.
FOLDING_SOURCE_UNIT=yards
DELIVERY_SOURCE_UNIT=yards

# Strict identifier policy. v3.2.3 permits only audited deterministic MIGPC-* PRE_COSTING placeholders produced by the certified normalizer; PO/Dispo/Challan identifiers are never fabricated.
MISSING_KEY_POLICY=error
INCLUDE_SKIPPED_ROWS=false
GENERATE_MISSING_KEYS=false
CREATE_PLACEHOLDER_PRECOSTING=false
CREATE_PLACEHOLDER_PO=false
ALLOW_PLACEHOLDER_PO_FOR_DISPO=false
IMPORT_VALIDATION_MODE=strict
REQUIRE_DB_FOR_DISPO_RESOLUTION=true
ALLOW_APPROVED_PLACEHOLDERS=true

# Keep enabled when the target schema has the warp-broken child tables.
INCLUDE_WARP_BROKEN_TABLES=true


# Bounded evidence/report memory. Exact counters are preserved even when detail rows are capped.
REPORT_DETAIL_LIMIT=1000
PREVIEW_DETAIL_LIMIT=500
SOURCE_REPORT_DETAIL_LIMIT=1000

CSV_DATE_ORDER=dmy
IMPORT_TERMINAL_LOGS=true
CLI_APP_LOG_DIR=./output/application_logs
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
LOG_MAX_FILE_BYTES=26214400
LOG_HUMAN_READABLE=true
LOG_STDERR_MIRROR=false
LOG_EXIT_ON_UNHANDLED=true
LOG_MAX_OBJECT_DEPTH=7
LOG_MAX_STRING_LENGTH=12000
LOG_MAX_ARRAY_LENGTH=100

# Set only after a full dry run has been accepted by scripts/v3/verify_full_dry_run.js.
APPROVED_DRY_RUN_ID=
