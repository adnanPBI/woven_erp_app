# Copy to a private .env.sync on cPanel, outside public_html.
# This file contains no credentials and does not enable scheduled writes.
SYNC_EXPECTED_DB=weavonpq_weaving_main
DB_NAME=weavonpq_weaving_main
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
SYNC_INTERVAL_MINUTES=10
SYNC_TIMEZONE=Asia/Dhaka
SYNC_START_DATE=2024-01-01
SYNC_BASELINE_CUTOFF=2026-09-22
SYNC_EXISTING_ROW_POLICY=apply-edits
SYNC_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/home/ACCOUNT/private_keys/google-service-account.json
FOLDING_SOURCE_UNIT=yards
DELIVERY_SOURCE_UNIT=yards

SYNC_DATA_DIR=/home/ACCOUNT/import_mapper_cli/sync_data
SYNC_BASELINE_FILE=/home/ACCOUNT/import_mapper_cli/baseline.meta.json
SYNC_REVIEWED_REASSIGNMENTS=/home/ACCOUNT/import_mapper_cli/reviewed-reassignments.json
# Optional alternative to the service account: SYNC_GOOGLE_MODE=public-csv
